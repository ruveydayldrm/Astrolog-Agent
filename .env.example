# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- LLM (yalnızca sunucuda kullanılır, istemciye ASLA gönderilmez) ---
# Ücretsiz: Google Gemini → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsiyonel model ayarları (varsayılanlar her zaman en güncel Flash modelini kullanır)
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_UTILITY_MODEL=gemini-flash-lite-latest

# Opsiyonel, ücretli: Anthropic Claude. Kullanmak için LLM_PROVIDER=anthropic yap.
# LLM_PROVIDER=gemini
# ANTHROPIC_API_KEY=sk-ant-...
# LYRA_CHAT_MODEL=claude-opus-5-5
# LYRA_UTILITY_MODEL=claude-opus-5-5

# Uygulamanın genel adresi (e-posta onay bağlantıları için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
